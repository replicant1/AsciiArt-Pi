#!/usr/bin/python3
"""
The last thing this machine does: everything dark, then the goodbye tune.

Installed as /usr/lib/systemd/system-shutdown/asciiart.shutdown.  Executables
in that directory run after every service has stopped and every filesystem has
been unmounted, immediately before the kernel halts - there is no later point
in userspace, which is why the tune lives here rather than in the app.  systemd
passes the kind of shutdown as the only argument: poweroff, halt, reboot or
kexec.

Order is the point.  The panel and both LEDs go out *first*, so that by the
time the tune sounds there is nothing left to see; the tune is last so that it
is the last thing at all.  Two LEDs, and they are not the same LED: the board's
own ACT light, which blinks at the disk, and the power LED on GPIO 4 that the
app lit at start-up.  Every name here says which.

**The power LED is put out here and nowhere else.**  It is not the app's to
extinguish.  GPIO 4 keeps its level after the process that set it exits, which
is what lets the light mean "this machine is up" rather than "ascii_camera is
running" - so the app never restarting it is the point, and only a real
poweroff should end it.  A reboot is left alone deliberately: the pad resets
itself on the way back up, and the app lights it again within seconds.

Three things here were each found the hard way, and none of them is obvious.

**The shebang is an absolute path.**  systemd-shutdown runs these with a
minimal environment, so `#!/usr/bin/env python3` has no PATH to search and the
script never starts - silently, because by then there is nothing to log to.

**The tune comes from the SoC's PWM block, and nothing here has a thread.**
That is the whole reason it can be trusted at this point in a shutdown. lgpio's
tx_pwm was tried first and is silently dead here: it times its waveform in a
helper thread, every call returns success, and the pin stays silent - the worst
way for a thing to be wrong. A hand-written square wave with a busy wait fixed
that and was plainly audible, and it is still here as `bit_bang_goodbye`, used
if the PWM channel cannot be reached at all.

Hardware PWM is better than either. The waveform is a clock divider and a
counter in silicon, so it needs no thread, no busy wait and no accurate sleep -
writing four files is the whole of it. It also removed the static from the
start-up tune, which was jitter in the software-timed version; this is the same
change applied to the farewell.

Note that /sys is in memory, not on the root filesystem, so it is still there
after everything is unmounted. The channel is normally exported already, by the
app's ExecStartPre at boot; `ensure_channel` covers the case where the app never
started.

This duplicates a little of src/control/buzzer.py on purpose. This script runs
after /home is unmounted, so it cannot import from the project, and being
self-contained is the only way it can be sure of running at all.

**The backlight is driven low with RPi.GPIO and never handed back.**  Releasing
the pin makes it an input and the module's own pull-up relights the panel;
src/lcd/lcd.py explains this at more length.  Whether it survives the *kernel*
halting is a separate question this cannot answer - if the firmware reverts the
pads at the very end, the panel lights again and no amount of userspace can
stop it.  gpio-poweroff is the one overlay that could hold a pin through halt,
and it is not an option: it disables booting by driving GPIO 3 low, which is
this box's only power switch.

Nothing here can log: the root filesystem is read only by now.  The tune is the
diagnostic - if it plays, this ran.  Bounded by an alarm, because a shutdown
hook that hangs is a machine that never powers down, which is far worse than a
missing tune.
"""

import os
import signal
import sys
import time

BACKLIGHT = 18          # LED/BL on the ILI9341 module, active high
BUZZER = 13             # PWM1; dtoverlay=pwm-2chan in config.txt makes it so
PWMCHIP = "/sys/class/pwm/pwmchip0"
PWM_CHANNEL = 1
NANOSECONDS = 1_000_000_000
DUTY = 50               # loudest a square wave gets
POWER_LED = 4           # the indicator the app lit at start-up
GOODBYE = ((880, 0.25), (440, 0.25))    # the greeting's notes, the other way up
DEADLINE = 8            # seconds for the whole script, tune included


def hush_the_panel():
    """Drive the backlight pin low, and deliberately do not hand it back."""
    import RPi.GPIO as GPIO
    GPIO.setwarnings(False)
    GPIO.setmode(GPIO.BCM)
    GPIO.setup(BACKLIGHT, GPIO.OUT)
    GPIO.output(BACKLIGHT, GPIO.LOW)
    # No GPIO.cleanup(). That is the whole trick.


def put_out_the_activity_led():
    """Stop the board's own ACT LED, so nothing blinks after the tune."""
    for path, value in (("/sys/class/leds/ACT/trigger", "none"),
                        ("/sys/class/leds/ACT/brightness", "0")):
        with open(path, "w") as f:
            f.write(value)


def douse_the_power_led():
    """
    Put out the GPIO 4 power LED that the app lit when it started.

    Freed rather than held, unlike the backlight above.  The two pins behave
    differently and it matters: releasing GPIO 18 lets the panel module's own
    pull-up relight it, whereas GPIO 4 keeps whatever level it was left at.
    Measured both ways on this Pi rather than assumed.
    """
    import lgpio
    handle = lgpio.gpiochip_open(0)
    try:
        lgpio.gpio_claim_output(handle, POWER_LED, 0)
        lgpio.gpio_free(handle, POWER_LED)
    finally:
        lgpio.gpiochip_close(handle)


def pwm_write(name, value):
    """Write one attribute of the buzzer's PWM channel."""
    with open(f"{PWMCHIP}/pwm{PWM_CHANNEL}/{name}", "w") as f:
        f.write(str(value))


def ensure_channel():
    """
    Make sure the PWM channel exists. Returns False if it cannot be had.

    Normally there is nothing to do: deploy/pwm_export.sh exported it from the
    service's ExecStartPre hours ago, and an export survives the service
    stopping because it is kernel state rather than anything the app holds.
    This is for the case where the app never started at all, which is exactly
    the run where a farewell is most worth hearing.
    """
    if os.path.exists(f"{PWMCHIP}/pwm{PWM_CHANNEL}"):
        return True
    if not os.path.isdir(PWMCHIP):
        return False                    # no overlay; nothing to export from
    try:
        with open(f"{PWMCHIP}/export", "w") as f:
            f.write(str(PWM_CHANNEL))
    except OSError:
        return False
    for _ in range(20):                 # the driver creates it asynchronously
        if os.path.exists(f"{PWMCHIP}/pwm{PWM_CHANNEL}"):
            return True
        time.sleep(0.05)
    return False


def bit_bang_goodbye():
    """
    The old way: a hand-written square wave with a busy wait.

    Kept as the fallback for a machine where the PWM channel cannot be reached -
    a config.txt that lost its overlay, most likely. It works because lgpio can
    take GPIO 13 back from alt0, which was checked rather than assumed. It
    sounds rougher, and rough is better than silent.
    """
    import lgpio
    handle = lgpio.gpiochip_open(0)
    try:
        lgpio.gpio_claim_output(handle, BUZZER, 0)
        for frequency, seconds in GOODBYE:
            half = 0.5 / frequency
            end = time.perf_counter() + seconds
            level = 0
            while time.perf_counter() < end:
                level ^= 1
                lgpio.gpio_write(handle, BUZZER, level)
                target = time.perf_counter() + half
                while time.perf_counter() < target:
                    pass
            lgpio.gpio_write(handle, BUZZER, 0)
    finally:
        lgpio.gpio_write(handle, BUZZER, 0)
        lgpio.gpio_free(handle, BUZZER)
        lgpio.gpiochip_close(handle)


def play_goodbye(write=None):
    """
    The greeting's notes the other way up, through the PWM block.

    `write` exists so a test can pass one that records instead of one that makes
    a noise, the same way src/control/buzzer.py takes one.

    The notes run into each other: `enable` stays on and only the period
    changes, so the pair is one falling gesture rather than two events. Duty
    goes to zero before each period change because the driver refuses to shrink
    a period below the current duty - the farewell falls in pitch so it does not
    actually hit that, but the rule is written in rather than relied upon not to
    matter.

    Note this does NOT protect against the failure that has already happened
    once here, where the pin stayed silent while every call reported success.
    Nothing in software can, and only a real poweroff can tell you.
    """
    if write is None:
        if not ensure_channel():
            bit_bang_goodbye()
            return
        write = pwm_write

    try:
        for frequency, seconds in GOODBYE:
            period = round(NANOSECONDS / frequency)
            write("duty_cycle", 0)
            write("period", period)
            write("duty_cycle", period * DUTY // 100)
            write("enable", 1)
            time.sleep(seconds)
    finally:
        write("duty_cycle", 0)
        write("enable", 0)


def main(argv):
    # Not on a reboot: the machine is about to say hello again, and a farewell
    # three seconds before a greeting is noise rather than information.
    if argv[1:2] and argv[1] not in ("poweroff", "halt"):
        return 0

    signal.alarm(DEADLINE)
    for step in (hush_the_panel, put_out_the_activity_led,
                 douse_the_power_led, play_goodbye):
        try:
            step()
        except Exception:                          # noqa: BLE001
            # Nothing to log to and nothing to gain by stopping: a panel that
            # would not go dark is no reason to skip the tune, and neither is a
            # reason to delay the halt.
            pass
    signal.alarm(0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
